# LLM Service Configuration
# Your API Key (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Custom Base URL (Optional, e.g. for Qiniu Cloud or other compatible services)
OPENAI_BASE_URL=https://api.openai.com/v1

# Default Model (Optional)
OPENAI_MODEL=deepseek/deepseek-v3.2-exp


DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=ai_analysis

SERVER_PORT=3000
JWT_SECRET=your-jwt-secret-change-in-production


# SMTP（nodemailer，用于密码找回邮件）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_auth_code
SMTP_FROM="Gist Agent <your_email@example.com>"

# LangSmith Tracing (Optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=gist-agent
