# LLM Service Configuration
# Your API Key (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Custom Base URL (Optional, e.g. for Qiniu Cloud or other compatible services)
OPENAI_BASE_URL=https://api.openai.com/v1

# Default Model (Optional)
OPENAI_MODEL=deepseek/deepseek-v3.2-exp

# Thinking 参数兼容策略：auto 自动识别 DeepSeek，deepseek 强制启用，none 不发送供应商专属参数
LLM_THINKING_CONTROL=auto
# 可选：DeepSeek 思考强度（如 low/high/max）
LLM_REASONING_EFFORT=high


DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=gist_agent
REDIS_URL=redis://127.0.0.1:6379
EVENT_KEY_PREFIX=gist-agent
USER_GENERATION_CONCURRENCY_LIMIT=5
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=3001
GENERATION_GLOBAL_CONCURRENCY=20
GENERATION_PROVIDER_CONCURRENCY=10
GENERATION_HEARTBEAT_INTERVAL_MS=5000
GENERATION_LEASE_TTL_MS=20000
GENERATION_SEMAPHORE_WAIT_MS=2000

SERVER_PORT=3000
JWT_SECRET=your-jwt-secret-change-in-production


# SMTP（nodemailer，用于密码找回邮件）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_auth_code
SMTP_FROM="Gist Agent <your_email@example.com>"

# LangSmith Tracing (Optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=gist-agent
