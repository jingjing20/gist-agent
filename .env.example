# LLM Service Configuration
# Your API Key (Required)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Custom Base URL (Optional, e.g. for Qiniu Cloud or other compatible services)
OPENAI_BASE_URL=https://api.qnaigc.com/v1

# Default Model (Optional)
OPENAI_MODEL=deepseek/deepseek-v3.2-exp


DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=xxxxxxxx
DB_NAME=ai_analysis

SERVER_PORT=3000
JWT_SECRET=your-jwt-secret-change-in-production


# SMTP（nodemailer，用于密码找回邮件）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=1269928993@qq.com
SMTP_PASS=xxxxxxxxxxxxxxxxx
SMTP_FROM="Gist Agent <1269928993@qq.com>"

# LangSmith Tracing (Optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=gist-agent
