{
    "name": "gist-agent",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev:api": "pnpm --filter @gist/api dev",
        "dev:worker": "pnpm --filter @gist/worker dev",
        "dev:web": "pnpm --filter @gist/web dev",
        "dev": "concurrently -n api,worker,web \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
        "build": "pnpm -r --if-present build",
        "typecheck": "pnpm -r --if-present typecheck",
        "smoke:conversation": "node scripts/smoke-multi-conversation.mjs",
        "benchmark:analytics": "pnpm --filter @gist/api benchmark:analytics",
        "benchmark:analytics:update": "pnpm --filter @gist/api benchmark:analytics:update",
        "test:reasoning": "pnpm --filter @gist/worker... build && node scripts/reasoning-context-regression.mjs",
        "test:generation-baseline": "pnpm --filter @gist/worker... build && node scripts/generation-baseline-regression.mjs",
        "test:reliability:integration": "pnpm --filter @gist/worker... build && CHAT_TIMEOUT_MS=1000 node scripts/phase1-reliability-regression.mjs",
        "test:artifacts:integration": "pnpm --filter @gist/worker... build && node scripts/phase3-artifacts-regression.mjs",
        "test:security-quality": "pnpm --filter @gist/worker... build && node scripts/phase4-security-quality-regression.mjs",
        "test:database-role:integration": "pnpm --filter @gist/database... build && node scripts/phase4-database-integration.mjs",
        "test:schema-ranking": "pnpm --filter @gist/worker... build && node scripts/phase6-regression.mjs",
        "init-db": "pnpm --filter @gist/api init-db",
        "format": "prettier --write \"apps/**/*.{ts,vue,json}\" \"packages/**/*.{ts,json}\"",
        "test:analysis-core": "pnpm --filter @gist/api... --filter @gist/worker... build && node scripts/analysis-core-regression.mjs",
        "test:memories": "pnpm --filter @gist/database... build && node scripts/memory-regression.mjs",
        "test:memory-workflow": "pnpm --filter @gist/worker... build && node scripts/memory-workflow-regression.mjs",
        "test:analysis-state": "pnpm --filter @gist/worker... build && node scripts/analysis-state-regression.mjs",
        "test:analysis-presentation": "pnpm --filter @gist/api... build && node scripts/analysis-presentation-regression.mjs",
        "test:analysis-cutover": "pnpm --filter @gist/api... --filter @gist/worker... build && node scripts/analysis-cutover-regression.mjs",
        "migrate:database": "pnpm --filter @gist/database... build && node scripts/migrate-database.mjs",
        "test:analysis-failures": "pnpm --filter @gist/worker... build && node scripts/analysis-failure-regression.mjs",
        "test:prompts": "pnpm --filter @gist/api... --filter @gist/worker... build && node scripts/prompt-runtime-regression.mjs && node scripts/schema-enrichment-regression.mjs && node scripts/follow-up-suggestions-regression.mjs && node scripts/analysis-text-channel-regression.mjs",
        "migrate:memory-provenance": "pnpm --filter @gist/database... build && node scripts/migrate-memory-provenance.mjs"
    },
    "devDependencies": {
        "@gist/config": "workspace:*",
        "@gist/database": "workspace:*",
        "concurrently": "^9.1.2",
        "prettier": "^3.5.3"
    }
}
